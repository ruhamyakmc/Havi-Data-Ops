{
  "communities": {
    "uganda": {
      "community_name": "Uganda",
      "country": "uganda",
      "remotefilepath_download": "/data/"
    }
  },
  "ftp": {
    "hostname": "ftp.example.com",
    "username_havi": "ftp_username"
  },
  "keyfiles": {
    "ftp_cred_filename_HAVI": "secrets/HAVI.ini",
    "ftp_key_file_HAVI": "secrets/HAVI.key"
  },
  "db": {
    "host": "db",
    "port": 5432,
    "name": "havi",
    "user": "havi_user",
    "password_secret_file": "/run/secrets/db_password"
  },
  "trial": {
    "name": "havi",
    "dedup_key": "uniqueid",
    "dedup_strategy": "latest_snapshot",
    "valid_mrc_codes": [12, 23, 25, 29, 31, 36, 37, 40, 42, 47, 56, 59, 62, 64, 66, 69, 70],
    "study_start_date": "2026-04-13"
  },
  "schedule": {
    "pipeline_cron": "0 6 * * *"
  },
  "email": {
    "smtp_host": "smtp.example.com",
    "smtp_port": 587,
    "sender": "havi-etl@example.com",
    "smtp_username": "havi-etl@example.com",
    "pipeline_recipients": ["pi@example.com"],
    "field_recipients": {
      "uganda": ["dm-uganda@example.com"]
    },
    "notify_countries": ["uganda"],
    "keyfiles": {
      "smtp_ini": "secrets/SMTP.ini",
      "smtp_key": "secrets/SMTP.key"
    }
  },
  "export": {
    "n_collections": 2
  },
  "box": {
    "folder_id": "123456789"
  },
  "session_id_corrections": {
    "ento_collection": [
      {
        "_comment": "Rename a session_id (e.g. hhid was re-registered)",
        "session_id": "old-session-id",
        "correct_session_id": "new-session-id"
      }
    ]
  },
  "record_corrections": {
    "ento_mosquito": [
      {
        "_comment": "Fix clocation on a specific mosquito record",
        "uniqueid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
        "correct_fields": {
          "session_id": "123456789-2026-05-01-1",
          "clocation": 1
        }
      }
    ],
    "ento_collection": [
      {
        "_comment": "Correct numfanoph count after a barcode was moved indoor/outdoor",
        "uniqueid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
        "correct_fields": {
          "numfanoph": 10
        }
      }
    ]
  },
  "exclusions": {
    "hbo_person": [
      {
        "_comment": "Exclude duplicate data-entry records",
        "uniqueid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
      }
    ]
  }
}
